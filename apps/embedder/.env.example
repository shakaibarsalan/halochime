# Copy to .env (local) or ~/talkfront/embedder.env (server). Never commit real values.

# Postgres for the background loop that embeds knowledge chunks. Unset = HTTP only.
# Local docker compose: postgres://talkfront:talkfront@db:5432/talkfront
# Server: postgres://talkfront_app:<APP_DB_PASSWORD>@db:5432/talkfront?sslmode=require
DATABASE_URL=

# Optional bearer token for POST /embed. If you set it, set the same EMBEDDER_TOKEN for the agent.
EMBEDDER_TOKEN=

# Optional tuning.
# EMBEDDER_PORT=8090
# EMBEDDER_THREADS=1
# EMBEDDER_BATCH=32
# EMBEDDER_POLL_SECONDS=5
