# Copy to .env and fill in. Never commit real values.

# Base URL of the web app (apps/web), and the shared secret for its internal API.
TALKFRONT_API_URL=http://localhost:3000
INTERNAL_API_SECRET=

# LiveKit Cloud project or self-hosted server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech to text and text to speech.
DEEPGRAM_API_KEY=

# Optional: ElevenLabs and Cartesia voices (and ElevenLabs brand voice clones). Without a key, agents
# that chose one of that provider's voices speak with the default voice. Set the same keys in apps/web.
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Replies: set the key for the provider your agents use (Groq models or Claude models).
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional, local testing only (console/connect have no dispatch metadata):
# TALKFRONT_DISPATCH_METADATA={"conversationId":"...","agentId":"...","organizationId":"...","mode":"text"}

# Optional: must be the same in apps/web and apps/agent. Use e.g. talkfront-agent-dev locally
# when you share a LiveKit project with production (default: talkfront-agent).
LIVEKIT_AGENT_NAME=

# Optional: semantic knowledge search through our own embedder (apps/embedder).
# Unset = text search only. Local: http://127.0.0.1:8090 (docker compose up -d embedder).
EMBEDDER_URL=
# Only if the embedder was started with EMBEDDER_TOKEN.
EMBEDDER_TOKEN=
