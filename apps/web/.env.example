# Postgres (docker compose: npm run db:up)
DATABASE_URL=postgres://talkfront:talkfront@localhost:5544/talkfront

# Better Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public origin of this app: used in the embed snippet and the widget origin check. Set it at build time too.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LiveKit project (cloud.livekit.io or self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared with apps/agent/.env
INTERNAL_API_SECRET=

# Optional: conversation summaries (Anthropic is used when set, otherwise Groq)
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: must be the same in apps/web and apps/agent. Use e.g. talkfront-agent-dev locally
# when you share a LiveKit project with production (default: talkfront-agent).
LIVEKIT_AGENT_NAME=

# Email (verification codes, password reset, invites, alerts). Gmail SMTP with an app password for now:
# about 500 emails a day, and EMAIL_FROM must be that Gmail address. Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_FROM="Talkfront <you@gmail.com>"
# Optional: where requests for voice minutes (Billing page) are emailed. Default: the address in EMAIL_FROM.
SUPPORT_EMAIL=
# Outside production, emails are written to apps/web/.outbox instead of sent. Set to 1 to really send.
EMAIL_DEV_SEND=

# Optional: "Continue with Google" (Google Cloud OAuth client, web application; redirect URI <APP_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
